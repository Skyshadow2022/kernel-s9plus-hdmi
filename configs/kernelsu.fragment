# KernelSU-Next (legacy) for non-GKI 4.9 — manual hooks, KPROBES off
CONFIG_KSU=y
CONFIG_KSU_MANUAL_HOOK=y
# CONFIG_KSU_KPROBES_HOOK is not set
# CONFIG_KSU_DEBUG is not set
# CONFIG_KPROBES is not set
CONFIG_OVERLAY_FS=y
# LOCALVERSION must NOT match the GKI uname pattern:
#   w.x.y-androidZ-K   (e.g. 5.10.101-android13-0)
# libvintf/libkver parses that as a GKI release and sets kernel FCM level
# from Android Z (13 → level 7). Our device manifest is target-level 3 on
# a legacy 4.9 kernel, so a fake GKI string makes
# VintfObject.verifyWithoutAvb() return 1 and PE shows
# "internal problem / contact manufacturer" every boot.
# Avoid "ksu"/"ksun"/"decon"/"dp" tokens (app-visible in uname -r).
CONFIG_LOCALVERSION="-aosp13-8-g0123456789ab"
