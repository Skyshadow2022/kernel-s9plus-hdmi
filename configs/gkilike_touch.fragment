# Pseudo-GKI milestone 1 fragment — apply on top of existing out/.config
CONFIG_LOCALVERSION="-decon-gkilike"
# CONFIG_LOCALVERSION_AUTO is not set

# Display core stays built-in
CONFIG_EXYNOS_DECON_9810=y
CONFIG_EXYNOS_DECON_FB=y
CONFIG_EXYNOS_DECON_LCD=y
CONFIG_EXYNOS_DECON_LCD_S6E3HA8=y

# Touch driver built INTO the kernel (was =m "gkilike pilot"). Building it in
# removes the sec_ts_drv.ko module entirely: no ak3-helper insmod, no vermagic
# that must be re-matched every time LOCALVERSION changes, no dead touch after
# a kernel rename. This is how the stock Samsung kernel shipped it, and the
# y761 firmware it needs is already present at /vendor/firmware/tsp_sec/.
CONFIG_TOUCHSCREEN_SEC_TS=y
