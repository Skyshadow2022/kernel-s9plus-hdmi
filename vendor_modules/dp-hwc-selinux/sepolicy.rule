# magiskpolicy/ksud syntax: space-separated (NO type:class colons — those fail to parse)
allow hal_graphics_composer_default sysfs file { read open getattr map }
allow hal_graphics_composer_default sysfs dir { search open read getattr }
allow hal_graphics_composer_default sysfs_displayport_writable file { read write open getattr map }
allow hal_graphics_composer_default sysfs_displayport_writable dir { search open read getattr }
allow hal_graphics_composer_default sysfs_extcon file { read open getattr }
allow hal_graphics_composer_default sysfs_extcon dir { search open read getattr }
